# Copy this file to .env.local and add project-specific values.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only NestJS origin. Next.js proxies /api/* so auth cookies stay same-origin.
SERVICE_URL=http://localhost:9000

# Optional: runtime base URL used by the generated example-service client.
NEXT_PUBLIC_SERVICE=http://localhost:9000

# Optional: enable Tolgee in-context editing and remote CLI commands.
NEXT_PUBLIC_TOLGEE_API_URL=https://app.tolgee.io
NEXT_PUBLIC_TOLGEE_API_KEY=
NEXT_PUBLIC_TOLGEE_DEVTOOLS=false
TOLGEE_API_URL=https://app.tolgee.io
TOLGEE_API_KEY=
TOLGEE_PROJECT_ID=
